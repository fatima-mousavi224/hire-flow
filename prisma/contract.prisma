// use prisma-next

model Company {
  id          String   @id @default(uuid())
  name        String
  logoUrl     String?
  bgColor     String?  @default("bg-slate-900")
  industry    String?  @default("Technology")
  description String?
  employees   String?  @default("500-1,000 emp")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  jobs Job[]
}

model Job {
  id            String        @id @default(uuid())
  title         String
  companyId     String
  location      String
  salary        String?
  jobType       JobType       @default(FULL_TIME)
  workplaceType WorkplaceType @default(HYBRID)
  tags          String[]
  isFeatured    Boolean       @default(false)
  dueDate       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now())

company      Company       @relation(fields: [companyId], references: [id])
  applications Application[]
}

model Testimonial {
  id                    String   @id @default(uuid())
  quote                 String
  authorName            String
  authorRole            String
  authorCompanyOrSchool String
  rating                Int      @default(5)
  avatarColor           String?  @default("bg-indigo-600")
  createdAt             DateTime @default(now())
}

model Application {
  id        String   @id @default(uuid())
  jobId     String
  fullName  String
  email     String
  resumeUrl String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum WorkplaceType {
  REMOTE
  HYBRID
  ON_SITE
}